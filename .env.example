# BidAlert Comms Hub — Environment Configuration
# Copy this file to .env and fill in REAL values. Never commit .env to git.
# On PythonAnywhere, store as ~/bidalert.env (chmod 600) and set ENV_FILE=/home/<user>/bidalert.env

# ─── Django core ─────────────────────────────────────────────────────────────
# Generate with: python scripts/gen_secrets.py
SECRET_KEY=change-me-use-scripts-gen_secrets-py

# Optional: comma-separated old keys for rotating without breaking signed URLs
# SECRET_KEY_FALLBACKS=old-key-1,old-key-2

DEBUG=False

# Comma-separated hostnames (no protocol, no port)
# Example: ALLOWED_HOSTS=app.bidalert.in,bidalert.pythonanywhere.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Full https:// URL of the app (no trailing slash)
BASE_URL=http://localhost:8000

# ─── Database ────────────────────────────────────────────────────────────────
# Option A: SQLite (local dev or initial test):
DATABASE_URL=sqlite:///db.sqlite3

# Option B: Neon DB (Serverless PostgreSQL — Recommended for Cloud):
# DATABASE_URL=postgresql://<user>:<password>@<ep-pooler-id>.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option C: MySQL on PythonAnywhere (Built-in free with PA account):
# DATABASE_URL=mysql://<user>:<password>@<user>.mysql.pythonanywhere-services.com/<user>$bidalert

# ─── Google OAuth (Gmail) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Gemini AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# Model to use — verify the current name in Google AI Studio before deploying
# Recommended: gemini-1.5-flash-latest  (fast, cost-effective)
GEMINI_MODEL=gemini-1.5-flash-latest

# ─── Cron / Scheduler security ───────────────────────────────────────────────
# Generate with: python scripts/gen_secrets.py
# This secret protects the /api/process-queue endpoint from unauthorised calls.
CRON_SECRET=change-me-use-scripts-gen_secrets-py

# ─── HTTPS / Security ────────────────────────────────────────────────────────
# Set True only if you are certain X-Forwarded-Proto is trusted.
# On PA, prefer "Force HTTPS" in the Web tab and leave this False.
FORCE_HTTPS=False

# ─── Email presentation ──────────────────────────────────────────────────────
# Display name shown in recipients' email clients ("From: BidAlert <...>")
SENDER_DISPLAY_NAME=BidAlert

# Reply-To address for replies from recipients
REPLY_TO_EMAIL=info@bidalert.in

# ─── Sending timezone ────────────────────────────────────────────────────────
# Timezone for all send-window calculations (pytz name)
DEFAULT_SEND_TIMEZONE=Asia/Kolkata

# ─── Optional: path to env file (set on PythonAnywhere WSGI config) ──────────
# ENV_FILE=/home/<user>/bidalert.env
